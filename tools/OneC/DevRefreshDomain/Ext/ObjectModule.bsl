Функция RewriteOsDomain(ЦелевойДомен) Экспорт
    Записано = 0;
    Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
        Если Пользователь.АутентификацияОС Тогда
            Части = СтрРазделить(Пользователь.ПользовательОС, "\", Ложь);
            Пользователь.ПользовательОС = "\\" + ЦелевойДомен + "\" + Части[Части.Количество() - 1];
            Пользователь.Записать();
            Записано = Записано + 1;
        КонецЕсли;
    КонецЦикла;
    Возврат Записано;
КонецФункции
